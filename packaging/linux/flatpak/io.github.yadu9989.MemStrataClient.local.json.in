{
  "id": "io.github.yadu9989.MemStrataClient",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "25.08",
  "sdk": "org.freedesktop.Sdk",
  "command": "memstrata-runtime",
  "finish-args": [],
  "modules": [
    {
      "name": "memstrata-runtime",
      "buildsystem": "simple",
      "build-commands": [
        "install -Dm755 memstrata-eval-runtime /app/libexec/memstrata-eval-runtime",
        "install -Dm755 memstrata-runtime /app/bin/memstrata-runtime"
      ],
      "sources": [
        {
          "type": "file",
          "path": "payload/memstrata-eval-runtime"
        },
        {
          "type": "file",
          "path": "memstrata-runtime"
        }
      ]
    }
  ]
}
